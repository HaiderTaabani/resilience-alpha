    {
      "id": 10,
      "type": "logs",
      "title": "Orchestrateur : étapes de chaque incident",
      "description": "alerte_recue → etat_pendant_incident → blocage_ip → verification_transaction → incident_closed",
      "datasource": "Loki",
      "gridPos": {
        "x": 0,
        "y": 19,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "datasource": "Loki",
          "expr": "{service=\"orchestrator\"} |= \"\\\"event\\\"\"",
          "queryType": "range",
          "refId": "A"
        }
      ],
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending",
        "enableLogDetails": true,
        "dedupStrategy": "none",
        "prettifyLogMessage": false
